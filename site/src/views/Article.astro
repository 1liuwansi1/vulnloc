---
import Layout from '../layouts/Layout.astro';
import Commands from '../components/Commands.astro';
import { localizedContent } from '../i18n/content';
import { t, pathFor, type Locale } from '../i18n';
interface Props { locale: Locale; page: 'analysis' | 'reproducibility' | 'paper' | 'resources' }
const { locale, page } = Astro.props;
const value = localizedContent(locale,page);
const tr = (key: Parameters<typeof t>[1]) => t(locale,key);
const base = pathFor(locale).replace(/\/$/,'');
---
<Layout locale={locale} page={page} title={tr(page === 'reproducibility' ? 'Reproducibility' : page === 'resources' ? 'Data & resources' : page === 'paper' ? 'Paper · Draft' : 'Research analysis')}>
  <header class="page-hero wrap"><p class="eyebrow">{value.eyebrow}</p>{page === 'paper' && <span class="release-badge">{tr('PUBLIC DRAFT · AUTHOR/DOI PENDING')}</span>}<h1>{value.title}</h1><p class="intro">{value.intro}</p></header>
  <div class="page-body wrap prose-grid"><aside class="page-index" aria-label={tr('On this page')}><span class="mono">{tr('ON THIS PAGE')}</span>{page === 'reproducibility' && <a href="#commands">{tr('Run the artifact')}</a>}{value.sections.map((section,index) => <a href={`#section-${index+1}`}>{section.title}</a>)}</aside><div class="prose">
    {page === 'reproducibility' && <Commands locale={locale} />}
    {page === 'paper' && <section class="empty-status"><p class="eyebrow">{tr('Publication details')}</p><p>{tr('Authors · Affiliation · Venue · DOI:')} <strong>{tr('PENDING')}</strong></p><p>{tr('The manuscript is available in the repository at')} <code>paper/main.pdf</code>{tr('. It is not copied into this website’s public assets; this page provides a curated synopsis.')}</p><p>{tr('Author list and DOI are pending. No fabricated BibTeX, DOI, or external download is provided.')}</p><a class="text-link" href={`${base}/results/`}>{tr('Inspect the validated results ↗')}</a></section>}
    {value.sections.map((section,index) => <section id={`section-${index+1}`}><h2>{section.title}</h2>{section.body.map(p => <p>{p}</p>)}{section.items && <ul>{section.items.map(item => <li>{item}</li>)}</ul>}</section>)}
    {page === 'resources' && <><section id="code"><p class="eyebrow">{tr('Code & data')}</p><h2>{tr('Local candidate.')}<br /><em>{tr('Public URLs pending.')}</em></h2><p>{tr('The metrics-only artifact derives from VulnGym entries. The two studies use the same 80 known entries, not two independent samples. Raw conversations, advisory text, labels, third-party source checkouts, embedding caches, and retrieval indexes are excluded.')}</p><p>{tr('Minimal entry metadata includes repository groups and description-only hint flags, not target files or line annotations. S0 scores derive from the independent audit and were checked against frozen raw answers during packaging; S1 additionally matches official per-record metrics.')}</p><p>GitHub · Zenodo · DOI: <strong>{tr('PENDING')}</strong>. {tr('No public links exist yet.')}</p><div class="resource-links"><a class="text-link" href={`${base}/reproducibility/`}>{tr('Offline guide ↗')}</a><a class="text-link" href={`${base}/methodology/`}>{tr('Methods ↗')}</a><a class="text-link" href={`${base}/paper/`}>{tr('Manuscript status ↗')}</a></div></section><section id="release"><p class="eyebrow">{tr('Release gate')}</p><h2>{tr('Published as a')}<br />{tr('research artifact.')}</h2><p>{tr('Copyright 2026 The vulnloc authors. Code is Apache-2.0; metrics-only data, manuscript and figures are CC BY 4.0. Individual authors, affiliation, venue and DOI remain PENDING. This is a research artifact, not a commercial vulnerability scanner.')}</p><p>{tr('The bilingual site is built from the reviewed static output and deployed via GitHub Actions. Only the scanned site/dist artifact is published; background checks run before deployment.')}</p></section></>}
  </div></div>
</Layout>
