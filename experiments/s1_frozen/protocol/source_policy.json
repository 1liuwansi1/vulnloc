{
  "extensions": [
    ".bash",
    ".c",
    ".cc",
    ".cmake",
    ".cpp",
    ".css",
    ".cxx",
    ".dart",
    ".go",
    ".gradle",
    ".h",
    ".hpp",
    ".htm",
    ".html",
    ".java",
    ".jinja",
    ".jinja2",
    ".js",
    ".jsx",
    ".kt",
    ".kts",
    ".less",
    ".lua",
    ".m",
    ".mk",
    ".mm",
    ".nix",
    ".php",
    ".pl",
    ".proto",
    ".py",
    ".r",
    ".rb",
    ".rs",
    ".scss",
    ".sh",
    ".sol",
    ".sql",
    ".svelte",
    ".swift",
    ".tf",
    ".ts",
    ".tsx",
    ".vue",
    ".zsh"
  ],
  "skip_filenames": [
    ".dockerignore",
    ".gitattributes",
    ".gitignore",
    ".gitmodules",
    ".npmignore"
  ],
  "skip_directories": [
    ".git",
    "node_modules",
    "__pycache__",
    ".venv",
    "venv",
    "dist",
    "build",
    ".next"
  ],
  "max_file_bytes": 200000,
  "binary_prefix_bytes": 8192,
  "binary_nul_excluded": true,
  "symlinks": "exclude",
  "no_extension": "allow",
  "ordering": "lexicographic-relative-path",
  "version": "source-v2"
}
